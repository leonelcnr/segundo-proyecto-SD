# Copiar a .env y completar. .env no va al repo.
# IP de Tailscale de este server (tailscale ip -4)
TAILSCALE_IP=100.x.y.z
# Mismo valor que el header "Authorization: Bearer ..." del conector HTTP de EMQX.
# Generar con: openssl rand -hex 32
WEBHOOK_TOKEN=
# Login del dashboard. Nada de admin/admin.
ADMIN_USER=
ADMIN_PASSWORD=
# Firma de los JWT del login. Generar con: openssl rand -hex 32
JWT_SECRET=
# Broker. Sin MQTT_URL el dashboard anda igual, pero no puede mandar decisiones.
# Local: mqtt://localhost:1883   Real: mqtts://<ip-tailscale-del-broker>:8883
MQTT_URL=
# Usuario MQTT del dashboard; también es el {admin} de usuario/{admin}/pedido
MQTT_USER=dashboard
MQTT_PASSWORD=
# Ruta a la CA del proyecto (solo con mqtts://). La CA no va al repo.
MQTT_CA=
