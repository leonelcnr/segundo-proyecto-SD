# Copiar a .env y completar. .env no va al repo.
# IP de Tailscale de este server (tailscale ip -4)
TAILSCALE_IP=100.x.y.z
# Mismo valor que el header "X-Token" del conector HTTP de EMQX (protocolo, sección 7).
# Generar con: openssl rand -hex 32
WEBHOOK_TOKEN=
# Login del dashboard. Nada de admin/admin.
ADMIN_USER=
ADMIN_PASSWORD=
# Firma de los JWT del login. Generar con: openssl rand -hex 32
JWT_SECRET=
# Broker. Sin MQTT_URL el dashboard solo muestra los webhooks: no ve solicitudes ni puede decidir.
# Local: mqtt://localhost:1883   Real: mqtts://sd-2026.tailb9d8eb.ts.net:18108
MQTT_URL=
# Usuario MQTT del admin (= client ID); también es el {admin} de usuario/{admin}/pedido y /aviso
MQTT_USER=admin-1
# Mismo secreto que el autenticador JWT de EMQX (HS256). Con esto el dashboard entra con un JWT y no usa MQTT_PASSWORD.
# Generar con: openssl rand -hex 32. Se pasa por privado, nunca por el grupo ni el repo.
MQTT_JWT_SECRET=
# Solo si EMQX no tiene autenticador JWT (por ejemplo, el EMQX local de pruebas)
MQTT_PASSWORD=
# CA del proyecto, solo con mqtts:// (es pública, está en certs/). La ruta sirve igual local y en Docker.
MQTT_CA=certs/ca.crt
