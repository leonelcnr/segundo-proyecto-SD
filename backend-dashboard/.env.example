# Copiar a .env y completar. .env no va al repo.
# IP de Tailscale de este server (tailscale ip -4)
TAILSCALE_IP=100.x.y.z
# Mismo valor que el header "X-Token" del conector HTTP de EMQX (protocolo, sección 7).
# Generar con: openssl rand -hex 32
WEBHOOK_TOKEN=
# Login del dashboard. Nada de admin/admin.
ADMIN_USER=
ADMIN_PASSWORD=
# Firma de los JWT del login. Generar con: openssl rand -hex 32
JWT_SECRET=
# Broker. Sin MQTT_URL el dashboard solo muestra los webhooks: no ve solicitudes ni puede decidir.
# Local: mqtt://localhost:1883   Real: mqtts://broker.puertas:8883 (el nombre del certificado)
MQTT_URL=
# Usuario MQTT del admin (= client ID); también es el {admin} de usuario/{admin}/pedido y /aviso
MQTT_USER=admin-1
MQTT_PASSWORD=
# Ruta a la CA del proyecto (solo con mqtts://). La CA no va al repo.
MQTT_CA=
