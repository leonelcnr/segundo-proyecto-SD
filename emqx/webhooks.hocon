# Conector, webhook directo y reglas hacia el receptor del dashboard (guía, pasos 5 y 6).
# No se carga tal cual: configurar.sh reemplaza RECEPTOR_URL y WEBHOOK_TOKEN y lo pasa a "emqx ctl conf load".

connectors.http.receptor {
  enable = true
  url = "${RECEPTOR_URL}"
  headers {
    "X-Token" = "${WEBHOOK_TOKEN}"
    "content-type" = "application/json"
  }
}

actions.http.conexiones {
  connector = receptor
  parameters { method = post, path = "/webhook/conexiones", body = "${.}" }
}
actions.http.seguridad {
  connector = receptor
  parameters { method = post, path = "/webhook/seguridad", body = "${.}" }
}
actions.http.alarmas {
  connector = receptor
  parameters { method = post, path = "/webhook/alarmas", body = "${.}" }
}

rule_engine.rules {
  # Webhook directo: lo mismo que arma el panel en Integración → Webhook
  conexiones {
    sql = """SELECT * FROM "$events/client_connected", "$events/client_disconnected" """
    actions = ["http:conexiones"]
  }
  seguridad {
    sql = """SELECT clientid, username, topic, action, result, peerhost, timestamp FROM "$events/client_check_authz_complete" WHERE result = 'deny'"""
    actions = ["http:seguridad"]
  }
  alarmas {
    sql = """SELECT payload.puerta as puerta, payload.persona as persona, payload.detalle as detalle, timestamp FROM "acceso/+/eventos" WHERE payload.tipo = 'alarma'"""
    actions = ["http:alarmas"]
  }
}
